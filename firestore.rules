rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function nestedMemberPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }
    function legacyMemberPath(orgId) {
      return /databases/$(database)/documents/organization_members/$(request.auth.uid + '_' + orgId);
    }
    function reverseLegacyMemberPath(orgId) {
      return /databases/$(database)/documents/organization_members/$(orgId + '_' + request.auth.uid);
    }
    function hasAnyMemberDocument(orgId) {
      return signedIn() && (
        exists(nestedMemberPath(orgId)) ||
        exists(legacyMemberPath(orgId)) ||
        exists(reverseLegacyMemberPath(orgId))
      );
    }
    function membership(orgId) {
      return exists(nestedMemberPath(orgId))
        ? get(nestedMemberPath(orgId)).data
        : (exists(legacyMemberPath(orgId))
          ? get(legacyMemberPath(orgId)).data
          : get(reverseLegacyMemberPath(orgId)).data);
    }
    function membershipIsActive(orgId) {
      return hasAnyMemberDocument(orgId)
        && membership(orgId).get('status', 'active') in ['active', 'ativo'];
    }
    function isSystemAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('systemRole', '') in
          ['ceo', 'global_admin', 'ecosystem_owner', 'founder'];
    }
    function isOwner(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId))
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.get(
          'ownerUid',
          get(/databases/$(database)/documents/organizations/$(orgId)).data.get('ownerId', '')
        ) == request.auth.uid;
    }
    function hasProductAccess(orgId) {
      return isSystemAdmin() || (
        exists(/databases/$(database)/documents/organizations/$(orgId))
        && get(/databases/$(database)/documents/organizations/$(orgId)).data
          .get('apps', {}).get('raiz_e_mesa', {}).get('status', '') in ['active', 'trialing']
      );
    }
    function hasMembership(orgId) {
      return hasProductAccess(orgId) && (membershipIsActive(orgId) || isOwner(orgId) || isSystemAdmin());
    }
    function memberRole(orgId) {
      return membershipIsActive(orgId)
        ? membership(orgId).get('organizationRole', membership(orgId).get('role', ''))
        : (isOwner(orgId) ? 'owner' : '');
    }
    function role(orgId, allowed) {
      return hasMembership(orgId) && (isSystemAdmin() || memberRole(orgId) in allowed);
    }
    function hasPermission(orgId, permission) {
      return role(orgId, ['owner', 'admin'])
        || (membershipIsActive(orgId) && membership(orgId).get('permissions', {}).get(permission, false) == true);
    }
    function isOrgAdmin(orgId) {
      return isSystemAdmin() || role(orgId, ['owner', 'admin', 'pastor', 'data_admin']);
    }
    function canManagePresence(orgId) {
      return isSystemAdmin()
        || role(orgId, ['owner', 'admin', 'pastor', 'coordinator'])
        || hasPermission(orgId, 'canManagePresence');
    }
    function canManagePeople(orgId) {
      return isOrgAdmin(orgId) || hasPermission(orgId, 'canManagePeople');
    }
    function assignedToCongregation(orgId, congregationId) {
      return membershipIsActive(orgId) && congregationId is string
        && congregationId in membership(orgId).get('congregationIds', []);
    }
    function canAccessCongregation(orgId, congregationId) {
      return hasProductAccess(orgId)
        && (isOrgAdmin(orgId) || assignedToCongregation(orgId, congregationId));
    }
    function tenantCreate(orgId) {
      return request.resource.data.get('organizationId', '') == orgId;
    }
    function tenantUnchanged(orgId) {
      return resource.data.get('organizationId', '') == orgId
        && request.resource.data.get('organizationId', '') == orgId;
    }
    function congregationUnchanged() {
      return request.resource.data.get('congregationId', '') == resource.data.get('congregationId', '');
    }
    function validAudit(orgId) {
      return tenantCreate(orgId)
        && request.resource.data.get('actorId', '') == request.auth.uid
        && request.resource.data.get('action', '') is string
        && request.resource.data.get('createdAt', null) == request.time;
    }
    function validPresenceSessionCreate(orgId) {
      return tenantCreate(orgId)
        && request.resource.data.get('congregationId', '') is string
        && request.resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.get('openedAt', null) == request.time
        && request.resource.data.get('status', '') == 'open'
        && request.resource.data.get('expectedPeopleCount', -1) is number
        && request.resource.data.get('expectedPeopleCount', -1) >= 0
        && request.resource.data.get('minimumCoveragePercent', -1) is number
        && request.resource.data.get('minimumCoveragePercent', -1) >= 0
        && request.resource.data.get('minimumCoveragePercent', -1) <= 100;
    }
    function validPresenceCheckCreate(orgId) {
      let sessionId = request.resource.data.get('sessionId', '');
      let congregationId = request.resource.data.get('congregationId', '');
      let personId = request.resource.data.get('personId', '');
      let source = request.resource.data.get('source', '');
      let correctedFrom = request.resource.data.get('correctedFromCheckId', '');
      let sessionPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/presenceSessions/$(sessionId);
      let personPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/people/$(personId);
      let correctionPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/presenceChecks/$(correctedFrom);
      return tenantCreate(orgId)
        && sessionId is string
        && congregationId is string
        && personId is string
        && request.resource.data.get('actorId', '') == request.auth.uid
        && request.resource.data.get('recordedAt', null) == request.time
        && request.resource.data.get('state', '') in ['present_confirmed', 'absent_confirmed', 'unverified']
        && source in ['human_check', 'retroactive_human_correction', 'manual_import']
        && exists(sessionPath)
        && get(sessionPath).data.get('congregationId', '') == congregationId
        && (get(sessionPath).data.get('status', '') == 'open' || source == 'retroactive_human_correction')
        && exists(personPath)
        && get(personPath).data.get('congregationId', '') == congregationId
        && (
          correctedFrom == ''
          || (
            source == 'retroactive_human_correction'
            && exists(correctionPath)
            && get(correctionPath).data.get('organizationId', '') == orgId
            && get(correctionPath).data.get('congregationId', '') == congregationId
            && get(correctionPath).data.get('sessionId', '') == sessionId
            && get(correctionPath).data.get('personId', '') == personId
          )
        );
    }
    function validCanonicalFact(orgId) {
      let eventType = request.resource.data.get('eventType', '');
      let payload = request.resource.data.get('payload', {});
      let personId = payload.get('personId', '');
      let sessionId = payload.get('sessionId', '');
      let checkId = payload.get('checkId', '');
      let personPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/people/$(personId);
      let sessionPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/presenceSessions/$(sessionId);
      let checkPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/presenceChecks/$(checkId);
      return tenantCreate(orgId)
        && request.resource.data.get('actorId', '') == request.auth.uid
        && request.resource.data.get('sourceApp', '') == 'nestjourney'
        && request.resource.data.get('version', 0) == 1
        && request.resource.data.get('recordedAt', null) == request.time
        && request.resource.data.get('occurredAt', null) == request.time
        && request.resource.data.get('subjectRef', '') is string
        && request.resource.data.get('scope', '') is string
        && request.resource.data.get('evidenceRef', '') is string
        && request.resource.data.get('evidenceRef', '').size() > 0
        && request.resource.data.get('sensitivity', '') in ['public', 'internal', 'confidential', 'restricted']
        && eventType in ['VISITOR_REGISTERED', 'PRESENCE_SESSION_OPENED', 'PRESENCE_CONFIRMED', 'PRESENCE_CORRECTED']
        && (
          (eventType == 'VISITOR_REGISTERED'
            && personId is string
            && request.resource.data.get('subjectRef', '') == 'person:' + personId
            && request.resource.data.get('evidenceRef', '') == 'person:' + personId
            && existsAfter(personPath)
            && request.resource.data.get('scope', '') == 'congregation:' + getAfter(personPath).data.get('congregationId', ''))
          ||
          (eventType == 'PRESENCE_SESSION_OPENED'
            && sessionId is string
            && request.resource.data.get('subjectRef', '') == 'presenceSession:' + sessionId
            && request.resource.data.get('evidenceRef', '') == 'presenceSession:' + sessionId
            && existsAfter(sessionPath)
            && request.resource.data.get('scope', '') == 'congregation:' + getAfter(sessionPath).data.get('congregationId', ''))
          ||
          (eventType in ['PRESENCE_CONFIRMED', 'PRESENCE_CORRECTED']
            && checkId is string
            && request.resource.data.get('evidenceRef', '') == 'presenceCheck:' + checkId
            && existsAfter(checkPath)
            && getAfter(checkPath).data.get('state', '') != 'unverified'
            && request.resource.data.get('subjectRef', '') == 'person:' + getAfter(checkPath).data.get('personId', '')
            && request.resource.data.get('scope', '') == 'congregation:' + getAfter(checkPath).data.get('congregationId', '')
            && (eventType != 'PRESENCE_CORRECTED' || getAfter(checkPath).data.get('correctedFromCheckId', '') != '')
          )
        );
    }

    match /organizations/{orgId} {
      allow read: if hasMembership(orgId);
      allow create, update, delete: if false;

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isOrgAdmin(orgId));
        allow write: if false;
      }
      match /products/raiz_e_mesa {
        allow read: if hasMembership(orgId);
        allow write: if false;

        match /congregations/{congregationId} {
          allow read: if canAccessCongregation(orgId, congregationId);
          allow create: if isOrgAdmin(orgId) && tenantCreate(orgId);
          allow update: if isOrgAdmin(orgId) && tenantUnchanged(orgId);
          allow delete: if false;
        }
        match /people/{personId} {
          allow read: if canAccessCongregation(orgId, resource.data.get('congregationId', ''));
          allow create: if tenantCreate(orgId)
            && request.resource.data.get('deletedAt', null) == null
            && canAccessCongregation(orgId, request.resource.data.get('congregationId', ''))
            && canManagePeople(orgId);
          allow update: if tenantUnchanged(orgId) && congregationUnchanged()
            && canAccessCongregation(orgId, resource.data.get('congregationId', ''))
            && canManagePeople(orgId);
          allow delete: if false;
        }
        match /presenceSessions/{sessionId} {
          allow read: if canManagePresence(orgId)
            && canAccessCongregation(orgId, resource.data.get('congregationId', ''));
          allow create: if canManagePresence(orgId)
            && canAccessCongregation(orgId, request.resource.data.get('congregationId', ''))
            && validPresenceSessionCreate(orgId);
          allow update: if canManagePresence(orgId)
            && resource.data.get('status', '') == 'open'
            && tenantUnchanged(orgId)
            && congregationUnchanged()
            && canAccessCongregation(orgId, resource.data.get('congregationId', ''))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt', 'closedBy'])
            && request.resource.data.get('status', '') == 'closed'
            && request.resource.data.get('closedAt', null) == request.time
            && request.resource.data.get('closedBy', '') == request.auth.uid;
          allow delete: if false;
        }
        match /presenceChecks/{checkId} {
          allow read: if canManagePresence(orgId)
            && canAccessCongregation(orgId, resource.data.get('congregationId', ''));
          allow create: if canManagePresence(orgId)
            && canAccessCongregation(orgId, request.resource.data.get('congregationId', ''))
            && validPresenceCheckCreate(orgId);
          allow update, delete: if false;
        }
        match /facts/{factId} {
          allow read: if isOrgAdmin(orgId);
          allow create: if hasMembership(orgId)
            && (
              (request.resource.data.get('eventType', '') == 'VISITOR_REGISTERED' && canManagePeople(orgId))
              || (request.resource.data.get('eventType', '') in ['PRESENCE_SESSION_OPENED', 'PRESENCE_CONFIRMED', 'PRESENCE_CORRECTED'] && canManagePresence(orgId))
            )
            && validCanonicalFact(orgId);
          allow update, delete: if false;
        }
        match /groups/{groupId} {
          allow read: if canAccessCongregation(orgId, resource.data.get('congregationId', ''));
          allow create: if tenantCreate(orgId)
            && canAccessCongregation(orgId, request.resource.data.get('congregationId', ''))
            && (isOrgAdmin(orgId) || hasPermission(orgId, 'canManageGroups'));
          allow update: if tenantUnchanged(orgId) && congregationUnchanged()
            && canAccessCongregation(orgId, resource.data.get('congregationId', ''))
            && (isOrgAdmin(orgId) || hasPermission(orgId, 'canManageGroups'));
          allow delete: if false;
        }
        match /discipleships/{discipleshipId} {
          allow read: if canAccessCongregation(orgId, resource.data.get('congregationId', ''))
            && (isOrgAdmin(orgId) || resource.data.get('disciplerId', '') == request.auth.uid);
          allow create: if tenantCreate(orgId)
            && canAccessCongregation(orgId, request.resource.data.get('congregationId', ''))
            && (isOrgAdmin(orgId) || request.resource.data.get('disciplerId', '') == request.auth.uid);
          allow update: if tenantUnchanged(orgId) && congregationUnchanged()
            && canAccessCongregation(orgId, resource.data.get('congregationId', ''))
            && (isOrgAdmin(orgId) || resource.data.get('disciplerId', '') == request.auth.uid)
            && request.resource.data.get('disciplerId', '') == resource.data.get('disciplerId', '');
          allow delete: if false;
        }
        match /pastoral/{pastoralId} {
          allow read: if role(orgId, ['owner', 'pastor']);
          allow create: if tenantCreate(orgId) && role(orgId, ['owner', 'pastor']);
          allow update: if tenantUnchanged(orgId) && role(orgId, ['owner', 'pastor']);
          allow delete: if false;
        }
        match /audit/{auditId} {
          allow read: if isOrgAdmin(orgId);
          allow create: if hasMembership(orgId) && validAudit(orgId);
          allow update, delete: if false;
        }
        match /retentionRequests/{requestId} {
          allow read: if role(orgId, ['owner', 'admin', 'data_admin']);
          allow create: if hasMembership(orgId) && tenantCreate(orgId)
            && request.resource.data.get('requestedBy', '') == request.auth.uid;
          allow update, delete: if false;
        }
        match /{document=**} { allow read, write: if false; }
      }
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /organization_members/{membershipId} {
      allow read: if signedIn()
        && resource.data.get('uid', resource.data.get('userId', '')) == request.auth.uid;
      allow write: if false;
    }
    match /subscriptions/{orgId} {
      allow read: if hasMembership(orgId);
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
