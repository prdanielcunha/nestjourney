    function validGroupAttendanceCreate(orgId, attendanceId) {
      let groupId = request.resource.data.get('groupId', '');
      let meetingId = request.resource.data.get('meetingId', '');
      let personId = request.resource.data.get('personId', '');
      let congregationId = request.resource.data.get('congregationId', '');
      let meetingPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/groupMeetings/$(meetingId);
      let membershipPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/groupMemberships/$(groupId + '__' + personId);
      return request.resource.data.keys().hasOnly([
          'organizationId', 'congregationId', 'groupId', 'meetingId',
          'personId', 'status', 'recordedAt', 'recordedBy'
        ])
        && tenantCreate(orgId)
        && attendanceId == meetingId + '__' + personId
        && groupId is string && groupId.size() > 0
        && meetingId is string && meetingId.size() > 0
        && personId is string && personId.size() > 0
        && congregationId is string && congregationId.size() > 0
        && request.resource.data.get('status', '') == 'present_confirmed'
        && request.resource.data.get('recordedAt', null) == request.time
        && request.resource.data.get('recordedBy', '') == request.auth.uid
        && canManageGroupRoster(orgId, groupId)
        && exists(meetingPath)
        && get(meetingPath).data.get('groupId', '') == groupId
        && get(meetingPath).data.get('congregationId', '') == congregationId
        && get(meetingPath).data.get('status', '') == 'open'
        && exists(membershipPath)
        && get(membershipPath).data.get('groupId', '') == groupId
        && get(membershipPath).data.get('personId', '') == personId
        && get(membershipPath).data.get('congregationId', '') == congregationId
        && get(membershipPath).data.get('status', '') == 'active';
    }

    function validDiscipleshipCreate() {
      return request.resource.data.get('personId', '') is string
        && request.resource.data.get('personId', '').size() > 0
        && request.resource.data.get('disciplerId', '') is string
        && request.resource.data.get('disciplerId', '').size() > 0
        && request.resource.data.get('meeting', 0) == 1
        && request.resource.data.get('status', '') == 'active';
    }
    function validDiscipleshipUpdate() {
      let meeting = request.resource.data.get('meeting', 0);
      let previousMeeting = resource.data.get('meeting', 0);
      let status = request.resource.data.get('status', '');
      return request.resource.data.get('personId', '') == resource.data.get('personId', '')
        && meeting is number
        && previousMeeting is number
        && meeting >= previousMeeting
        && meeting <= previousMeeting + 1
        && meeting >= 1
        && meeting <= 7
        && status in ['active', 'paused', 'completed']
        && (status != 'completed' || meeting == 7);
    }
    function validFollowupCanonicalFact(orgId, factId, eventType, payload) {
      let followupId = payload.get('followupId', '');
      let careRequestId = payload.get('careRequestId', '');
      let personId = payload.get('personId', '');
      let followupPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/followups/$(followupId);
      let followupData = getAfter(followupPath).data;
      return followupData.get('personId', '') == personId
        && followupData.get('careRequestId', '') == careRequestId
        && request.resource.data.get('subjectRef', '') == 'person:' + personId
        && request.resource.data.get('evidenceRef', '') == 'followup:' + followupId
        && request.resource.data.get('scope', '') == 'congregation:' + followupData.get('congregationId', '')
        && (
          (
            eventType == 'FOLLOWUP_CREATED'
            && factId == 'followup-created-' + followupId
            && followupData.get('status', '') == 'pending'
            && followupData.get('createdAt', null) == request.time
            && followupData.get('createdBy', '') == request.auth.uid
          )
          ||
          (
            eventType == 'FOLLOWUP_COMPLETED'
            && factId == 'followup-completed-' + followupId
            && followupData.get('status', '') == 'completed'
            && followupData.get('completedAt', null) == request.time
            && followupData.get('completedBy', '') == request.auth.uid
            && followupData.get('outcomeCode', '') == payload.get('outcomeCode', '')
            && followupData.get('nextActionCode', '') == payload.get('nextActionCode', '')
          )
        );
    }

    function validCareResolvedFactDocument(orgId, factId) {
      let payload = request.resource.data.get('payload', {});
      let careRequestId = payload.get('careRequestId', '');
      let personId = payload.get('personId', '');
      let carePath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/careRequests/$(careRequestId);
      let careData = getAfter(carePath).data;
