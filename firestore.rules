rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function nestedMemberPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }
    function legacyMemberPath(orgId) {
      return /databases/$(database)/documents/organization_members/$(request.auth.uid + '_' + orgId);
    }
    function reverseLegacyMemberPath(orgId) {
      return /databases/$(database)/documents/organization_members/$(orgId + '_' + request.auth.uid);
    }
    function hasAnyMemberDocument(orgId) {
      return signedIn() && (
        exists(nestedMemberPath(orgId)) ||
        exists(legacyMemberPath(orgId)) ||
        exists(reverseLegacyMemberPath(orgId))
      );
    }
    function membership(orgId) {
      return exists(nestedMemberPath(orgId))
        ? get(nestedMemberPath(orgId)).data
        : (exists(legacyMemberPath(orgId))
          ? get(legacyMemberPath(orgId)).data
          : get(reverseLegacyMemberPath(orgId)).data);
    }
    function membershipIsActive(orgId) {
      return hasAnyMemberDocument(orgId)
        && membership(orgId).get('status', 'active') in ['active', 'ativo'];
    }
    function isSystemAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('systemRole', '') in
          ['ceo', 'global_admin', 'ecosystem_owner', 'founder'];
    }
    function isOwner(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId))
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.get(
          'ownerUid',
          get(/databases/$(database)/documents/organizations/$(orgId)).data.get('ownerId', '')
        ) == request.auth.uid;
    }
    function hasProductAccess(orgId) {
      return isSystemAdmin() || (
        exists(/databases/$(database)/documents/organizations/$(orgId))
        && get(/databases/$(database)/documents/organizations/$(orgId)).data
          .get('apps', {}).get('raiz_e_mesa', {}).get('status', '') in ['active', 'trialing']
      );
    }
    function hasMembership(orgId) {
      return hasProductAccess(orgId) && (membershipIsActive(orgId) || isOwner(orgId) || isSystemAdmin());
    }
    function memberRole(orgId) {
      return membershipIsActive(orgId)
        ? membership(orgId).get('organizationRole', membership(orgId).get('role', ''))
        : (isOwner(orgId) ? 'owner' : '');
    }
    function role(orgId, allowed) {
      return hasMembership(orgId) && (isSystemAdmin() || memberRole(orgId) in allowed);
    }
    function hasPermission(orgId, permission) {
      return role(orgId, ['owner', 'admin'])
        || (membershipIsActive(orgId) && membership(orgId).get('permissions', {}).get(permission, false) == true);
    }
    function isOrgAdmin(orgId) {
      return isSystemAdmin() || role(orgId, ['owner', 'admin', 'pastor', 'data_admin']);
    }
    function canManagePresence(orgId) {
      return isSystemAdmin()
        || role(orgId, ['owner', 'admin', 'pastor', 'coordinator'])
        || hasPermission(orgId, 'canManagePresence');
    }
    function canManageMesa(orgId) {
      return isSystemAdmin()
        || role(orgId, ['owner', 'admin', 'pastor', 'coordinator', 'mesa', 'table_host'])
        || hasPermission(orgId, 'canManageMesa')
        || hasPermission(orgId, 'canManagePresence');
    }
    function canManagePeople(orgId) {
      return isOrgAdmin(orgId) || hasPermission(orgId, 'canManagePeople');
    }
    function canManageCare(orgId) {
      return isSystemAdmin()
        || role(orgId, ['owner', 'admin', 'pastor', 'care'])
        || hasPermission(orgId, 'canManageCare');
    }
    function canManagePastoral(orgId) {
      return isSystemAdmin()
        || role(orgId, ['owner', 'pastor'])
        || (
          membershipIsActive(orgId)
          && membership(orgId).get('permissions', {}).get('canManagePastoral', false) == true
        );
    }
    function canManageGroups(orgId) {
      return isSystemAdmin()
        || role(orgId, ['owner', 'admin', 'pastor', 'group_leader'])
        || hasPermission(orgId, 'canManageGroups');
    }
    function canManageGroupRoster(orgId, groupId) {
      let groupPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/groups/$(groupId);
      let active = membershipIsActive(orgId);
      let memberData = active ? membership(orgId) : {};
      let roleName = active ? memberData.get('organizationRole', memberData.get('role', '')) : '';
      let permissions = active ? memberData.get('permissions', {}) : {};
      let privileged = isSystemAdmin() || isOwner(orgId);
      let groupData = exists(groupPath) ? get(groupPath).data : {};
      let broad = roleName in ['owner', 'admin', 'pastor'];
      let ownsGroup = groupData.get('leaderId', '') == request.auth.uid || groupData.get('createdBy', '') == request.auth.uid;
      let inScope = privileged || broad || (
        active
        && groupData.get('congregationId', '') in memberData.get('congregationIds', [])
      );
      let allowed = privileged || (
        active
        && (
          broad
          || (
            (roleName == 'group_leader' || permissions.get('canManageGroups', false) == true)
            && ownsGroup
          )
        )
      );
      return exists(groupPath) && hasProductAccess(orgId) && inScope && allowed;
    }

    function canCreateGroupEntryRequest(orgId, groupId) {
      let groupPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/groups/$(groupId);
      return exists(groupPath)
        && canAccessCongregation(orgId, get(groupPath).data.get('congregationId', ''))
        && (
          isSystemAdmin()
          || isOwner(orgId)
          || role(orgId, ['owner', 'admin', 'pastor'])
        );
    }
    function canViewGovernance(orgId) {
      return isSystemAdmin()
        || role(orgId, ['owner', 'admin', 'pastor', 'data_admin'])
        || hasPermission(orgId, 'canViewGovernance');
    }
    function canManagePrivacy(orgId) {
      return isSystemAdmin()
        || role(orgId, ['owner', 'admin', 'data_admin'])
        || hasPermission(orgId, 'canManagePrivacy');
    }
    function canManageImplementation(orgId) {
      return isSystemAdmin()
        || role(orgId, ['owner', 'admin', 'pastor', 'coordinator'])
        || hasPermission(orgId, 'canManageImplementation');
    }
    function assignedToCongregation(orgId, congregationId) {
      return membershipIsActive(orgId) && congregationId is string
        && congregationId in membership(orgId).get('congregationIds', []);
    }
    function canAccessCongregation(orgId, congregationId) {
      return hasProductAccess(orgId)
        && (isOrgAdmin(orgId) || assignedToCongregation(orgId, congregationId));
    }
    function canCreateCareInScope(orgId, congregationId, source) {
      let active = membershipIsActive(orgId);
      let memberData = active ? membership(orgId) : {};
      let roleName = active
        ? memberData.get('organizationRole', memberData.get('role', ''))
        : '';
      let permissions = active ? memberData.get('permissions', {}) : {};
      let privileged = isSystemAdmin() || isOwner(orgId);
      let inScope = privileged || (
        active && (
          roleName in ['owner', 'admin', 'pastor', 'data_admin']
          || (congregationId is string && congregationId in memberData.get('congregationIds', []))
        )
      );
      let hasCareCapability = privileged || (
        active && (
          roleName in ['owner', 'admin', 'pastor', 'care']
          || permissions.get('canManageCare', false) == true
        )
      );
      let hasPeopleCapability = privileged || (
        active && (
          roleName in ['owner', 'admin', 'pastor', 'data_admin']
          || permissions.get('canManagePeople', false) == true
        )
      );
      return hasProductAccess(orgId)
        && inScope
        && (
          (source == 'manual' && hasCareCapability)
          || (source == 'visitor_registration' && hasPeopleCapability)
        );
    }
    function tenantCreate(orgId) {
      return request.resource.data.get('organizationId', '') == orgId;
    }
    function tenantUnchanged(orgId) {
      return resource.data.get('organizationId', '') == orgId
        && request.resource.data.get('organizationId', '') == orgId;
    }
    function congregationUnchanged() {
      return request.resource.data.get('congregationId', '') == resource.data.get('congregationId', '');
    }
    function validAudit(orgId) {
      let congregationId = request.resource.data.get('congregationId', '');
      return tenantCreate(orgId)
        && request.resource.data.get('actorId', '') == request.auth.uid
        && request.resource.data.get('action', '') is string
        && request.resource.data.get('createdAt', null) == request.time
        && (
          (congregationId is string && congregationId.size() > 0 && canAccessCongregation(orgId, congregationId))
          || (congregationId == '' && isOrgAdmin(orgId))
        );
    }
    function validPastoralHandoffCreate(orgId, handoffId) {
      let sourceCareRequestId = request.resource.data.get('sourceCareRequestId', '');
      let source = getAfter(/databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/careRequests/$(sourceCareRequestId)).data;
      return request.resource.data.keys().hasOnly([
          'organizationId', 'congregationId', 'personId', 'sourceCareRequestId',
          'status', 'requestedAt', 'requestedBy', 'resolvedAt', 'resolvedBy'
        ])
        && request.resource.data.get('organizationId', '') == orgId
        && sourceCareRequestId == handoffId
        && request.resource.data.get('status', '') == 'open'
        && request.resource.data.get('requestedAt', null) == request.time
        && request.resource.data.get('requestedBy', '') == request.auth.uid
        && request.resource.data.get('resolvedAt', null) == null
        && request.resource.data.get('resolvedBy', '') == ''
        && source.get('organizationId', '') == orgId
        && source.get('congregationId', '') == request.resource.data.get('congregationId', '')
        && source.get('personId', '') == request.resource.data.get('personId', '')
        && source.get('status', '') == 'resolved'
        && source.get('resolutionCode', '') == 'pastoral_handoff'
        && source.get('resolvedBy', '') == request.auth.uid;
    }
    function validPastoralHandoffResolve(orgId) {
      return tenantUnchanged(orgId)
        && congregationUnchanged()
        && resource.data.get('status', '') == 'open'
        && request.resource.data.get('personId', '') == resource.data.get('personId', '')
        && request.resource.data.get('sourceCareRequestId', '') == resource.data.get('sourceCareRequestId', '')
        && request.resource.data.get('requestedAt', null) == resource.data.get('requestedAt', null)
        && request.resource.data.get('requestedBy', '') == resource.data.get('requestedBy', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'resolvedBy'])
        && request.resource.data.get('status', '') == 'resolved'
        && request.resource.data.get('resolvedAt', null) == request.time
        && request.resource.data.get('resolvedBy', '') == request.auth.uid;
    }

    function validPrivacyRequestCreate(orgId) {
      let congregationId = request.resource.data.get('congregationId', '');
      let personId = request.resource.data.get('personId', '');
      let requestType = request.resource.data.get('requestType', '');
      let targetField = request.resource.data.get('targetField', '');
      let proposedValue = request.resource.data.get('proposedValue', '');
      let personPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/people/$(personId);
      return tenantCreate(orgId)
        && congregationId is string
        && personId is string
        && requestType in ['correction', 'consent_revocation', 'deletion_review', 'retention_review']
        && request.resource.data.get('status', '') == 'open'
        && request.resource.data.get('requestedAt', null) == request.time
        && request.resource.data.get('requestedBy', '') == request.auth.uid
        && exists(personPath)
        && get(personPath).data.get('congregationId', '') == congregationId
        && (
          (
            requestType == 'correction'
            && targetField in ['name', 'phone', 'firstVisit']
            && proposedValue is string
            && proposedValue.size() > 0
            && proposedValue.size() <= 120
          )
          || (
            requestType != 'correction'
            && targetField == ''
            && proposedValue == ''
          )
        );
    }
    function validPresenceSessionCreate(orgId) {
      return tenantCreate(orgId)
        && request.resource.data.get('congregationId', '') is string
        && request.resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.get('openedAt', null) == request.time
        && request.resource.data.get('status', '') == 'open'
        && request.resource.data.get('expectedPeopleCount', -1) is number
        && request.resource.data.get('expectedPeopleCount', -1) >= 0
        && request.resource.data.get('minimumCoveragePercent', -1) is number
        && request.resource.data.get('minimumCoveragePercent', -1) >= 0
        && request.resource.data.get('minimumCoveragePercent', -1) <= 100;
    }
    function validPresenceCheckCreate(orgId) {
      let sessionId = request.resource.data.get('sessionId', '');
      let congregationId = request.resource.data.get('congregationId', '');
      let personId = request.resource.data.get('personId', '');
      let sessionPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/presenceSessions/$(sessionId);
      let personPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/people/$(personId);
      return tenantCreate(orgId)
        && sessionId is string
        && congregationId is string
        && personId is string
        && request.resource.data.get('actorId', '') == request.auth.uid
        && request.resource.data.get('recordedAt', null) == request.time
        && request.resource.data.get('state', '') in ['present_confirmed', 'absent_confirmed', 'unverified']
        && request.resource.data.get('source', '') == 'human_check'
        && request.resource.data.get('correctedFromCheckId', '') == ''
        && exists(sessionPath)
        && get(sessionPath).data.get('congregationId', '') == congregationId
        && get(sessionPath).data.get('status', '') == 'open'
        && exists(personPath)
        && get(personPath).data.get('congregationId', '') == congregationId;
    }
    function canManageJourneySettings(orgId) {
      return isSystemAdmin() || role(orgId, ['owner', 'admin', 'pastor']);
    }
    function validModuleLabels(orgId) {
      let labels = request.resource.data.get('labels', {});
      return request.resource.data.get('organizationId', '') == orgId
        && labels is map
        && labels.keys().hasOnly(['presence', 'table', 'care', 'groups', 'discipleship'])
        && labels.get('presence', '') is string && labels.get('presence', '').size() <= 48
        && labels.get('table', '') is string && labels.get('table', '').size() <= 48
        && labels.get('care', '') is string && labels.get('care', '').size() <= 48
        && labels.get('groups', '') is string && labels.get('groups', '').size() <= 48
        && labels.get('discipleship', '') is string && labels.get('discipleship', '').size() <= 48
        && request.resource.data.get('updatedAt', null) == request.time
        && request.resource.data.get('updatedBy', '') == request.auth.uid
        && request.resource.data.keys().hasOnly(['organizationId', 'labels', 'updatedAt', 'updatedBy']);
    }

    function validMesaParticipationCreate(orgId, recordId) {
      let sessionId = request.resource.data.get('sessionId', '');
      let congregationId = request.resource.data.get('congregationId', '');
      let personId = request.resource.data.get('personId', '');
      let sessionPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/presenceSessions/$(sessionId);
      let personPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/people/$(personId);
      return tenantCreate(orgId)
        && recordId == sessionId + '__' + personId
        && congregationId is string
        && sessionId is string
        && personId is string
        && request.resource.data.get('status', '') in ['invited', 'joined']
        && request.resource.data.get('bondHostRef', '') is string
        && request.resource.data.get('bondHostRef', '').size() > 0
        && request.resource.data.get('updatedAt', null) == request.time
        && request.resource.data.get('updatedBy', '') == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'organizationId', 'congregationId', 'sessionId', 'personId',
          'status', 'bondHostRef', 'updatedAt', 'updatedBy'
        ])
        && exists(sessionPath)
        && get(sessionPath).data.get('congregationId', '') == congregationId
        && exists(personPath)
        && get(personPath).data.get('congregationId', '') == congregationId;
    }
    function validMesaParticipationUpdate(orgId) {
      return tenantUnchanged(orgId)
        && congregationUnchanged()
        && request.resource.data.get('sessionId', '') == resource.data.get('sessionId', '')
        && request.resource.data.get('personId', '') == resource.data.get('personId', '')
        && request.resource.data.get('status', '') in ['invited', 'joined']
        && request.resource.data.get('bondHostRef', '') == resource.data.get('bondHostRef', '')
        && request.resource.data.get('updatedAt', null) == request.time
        && request.resource.data.get('updatedBy', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'updatedBy'
        ]);
    }

    function validMesaPreparationCreate(orgId, preparationId) {
      let congregationId = request.resource.data.get('congregationId', '');
      let sessionId = request.resource.data.get('sessionId', '');
      let sessionPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/presenceSessions/$(sessionId);
      let items = request.resource.data.get('items', {});
      let owners = request.resource.data.get('owners', {});
      let allReady = items.get('environment', false)
        && items.get('hosts', false)
        && items.get('hospitality', false)
        && items.get('supplies', false);
      return request.resource.data.keys().hasOnly([
          'organizationId', 'congregationId', 'sessionId', 'status',
          'items', 'owners', 'updatedAt', 'updatedBy'
        ])
        && tenantCreate(orgId)
        && preparationId == sessionId
        && congregationId is string && congregationId.size() > 0
        && sessionId is string && sessionId.size() > 0
        && items is map
        && owners is map
        && items.keys().hasOnly(['environment', 'hosts', 'hospitality', 'supplies'])
        && owners.keys().hasOnly(['environment', 'hosts', 'hospitality', 'supplies'])
        && items.get('environment', false) is bool
        && items.get('hosts', false) is bool
        && items.get('hospitality', false) is bool
        && items.get('supplies', false) is bool
        && owners.get('environment', '') == (items.get('environment', false) ? request.auth.uid : '')
        && owners.get('hosts', '') == (items.get('hosts', false) ? request.auth.uid : '')
        && owners.get('hospitality', '') == (items.get('hospitality', false) ? request.auth.uid : '')
        && owners.get('supplies', '') == (items.get('supplies', false) ? request.auth.uid : '')
        && request.resource.data.get('status', '') == (allReady ? 'ready' : 'preparing')
        && request.resource.data.get('updatedAt', null) == request.time
        && request.resource.data.get('updatedBy', '') == request.auth.uid
        && canManageMesa(orgId)
        && exists(sessionPath)
        && get(sessionPath).data.get('congregationId', '') == congregationId
        && get(sessionPath).data.get('status', '') == 'open';
    }

    function validMesaPreparationUpdate(orgId) {
      let congregationId = resource.data.get('congregationId', '');
      let sessionId = resource.data.get('sessionId', '');
      let sessionPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/presenceSessions/$(sessionId);
      let items = request.resource.data.get('items', {});
      let owners = request.resource.data.get('owners', {});
      let oldItems = resource.data.get('items', {});
      let oldOwners = resource.data.get('owners', {});
      let allReady = items.get('environment', false)
        && items.get('hosts', false)
        && items.get('hospitality', false)
        && items.get('supplies', false);
      return tenantUnchanged(orgId)
        && congregationUnchanged()
        && request.resource.data.get('sessionId', '') == sessionId
        && request.resource.data.keys().hasOnly([
          'organizationId', 'congregationId', 'sessionId', 'status',
          'items', 'owners', 'updatedAt', 'updatedBy'
        ])
        && items is map
        && owners is map
        && items.keys().hasOnly(['environment', 'hosts', 'hospitality', 'supplies'])
        && owners.keys().hasOnly(['environment', 'hosts', 'hospitality', 'supplies'])
        && items.get('environment', false) is bool
        && items.get('hosts', false) is bool
        && items.get('hospitality', false) is bool
        && items.get('supplies', false) is bool
        && owners.get('environment', '') == (
          items.get('environment', false) == oldItems.get('environment', false)
            ? oldOwners.get('environment', '')
            : (items.get('environment', false) ? request.auth.uid : '')
        )
        && owners.get('hosts', '') == (
          items.get('hosts', false) == oldItems.get('hosts', false)
            ? oldOwners.get('hosts', '')
            : (items.get('hosts', false) ? request.auth.uid : '')
        )
        && owners.get('hospitality', '') == (
          items.get('hospitality', false) == oldItems.get('hospitality', false)
            ? oldOwners.get('hospitality', '')
            : (items.get('hospitality', false) ? request.auth.uid : '')
        )
        && owners.get('supplies', '') == (
          items.get('supplies', false) == oldItems.get('supplies', false)
            ? oldOwners.get('supplies', '')
            : (items.get('supplies', false) ? request.auth.uid : '')
        )
        && request.resource.data.get('status', '') == (allReady ? 'ready' : 'preparing')
        && request.resource.data.get('updatedAt', null) == request.time
        && request.resource.data.get('updatedBy', '') == request.auth.uid
        && canManageMesa(orgId)
        && exists(sessionPath)
        && get(sessionPath).data.get('congregationId', '') == congregationId
        && get(sessionPath).data.get('status', '') == 'open';
    }

    function validCareRequestCreate(orgId) {
      let congregationId = request.resource.data.get('congregationId', '');
      let personId = request.resource.data.get('personId', '');
      let source = request.resource.data.get('source', '');
      let ownerRef = request.resource.data.get('ownerRef', '');
      let summary = request.resource.data.get('summary', '');
      return tenantCreate(orgId)
        && congregationId is string
        && personId is string
        && request.resource.data.get('careType', '') in ['first_contact', 'prayer', 'pastoral_contact', 'group_interest', 'absence_check', 'operational_followup']
        && source in ['manual', 'visitor_registration']
        && request.resource.data.get('status', '') == 'open'
        && request.resource.data.get('requestedAt', null) == request.time
        && request.resource.data.get('requestedBy', '') == request.auth.uid
        && request.resource.data.get('promiseHours', 0) is number
        && request.resource.data.get('promiseHours', 0) >= 1
        && request.resource.data.get('promiseHours', 0) <= 168
        && request.resource.data.get('dueAt', null) is timestamp
        && request.resource.data.get('dueAt', null) > request.time
        && request.resource.data.get('dueAt', null) <= request.time + duration.value(168, 'h')
        && ownerRef is string
        && summary is string
        && summary.size() <= 160
        && (
          (source == 'manual'
            && ownerRef == request.auth.uid
            && request.resource.data.get('assignedAt', null) == request.time
            && request.resource.data.get('assignedBy', '') == request.auth.uid)
          ||
          (source == 'visitor_registration'
            && ownerRef == ''
            && request.resource.data.get('assignedAt', null) == null
            && request.resource.data.get('assignedBy', '') == '')
        );
    }
    function validCareClaim(orgId) {
      return resource.data.get('status', '') == 'open'
        && resource.data.get('ownerRef', '') == ''
        && tenantUnchanged(orgId)
        && congregationUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerRef', 'assignedAt', 'assignedBy'])
        && request.resource.data.get('ownerRef', '') == request.auth.uid
        && request.resource.data.get('assignedAt', null) == request.time
        && request.resource.data.get('assignedBy', '') == request.auth.uid;
    }
    function validCareResolve(orgId) {
      let note = request.resource.data.get('resolutionNote', '');
      return resource.data.get('status', '') == 'open'
        && (resource.data.get('ownerRef', '') == request.auth.uid || isOrgAdmin(orgId))
        && tenantUnchanged(orgId)
        && congregationUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'resolvedBy', 'resolutionCode', 'resolutionNote'])
        && request.resource.data.get('status', '') == 'resolved'
        && request.resource.data.get('resolvedAt', null) == request.time
        && request.resource.data.get('resolvedBy', '') == request.auth.uid
        && request.resource.data.get('resolutionCode', '') in ['contact_completed', 'pastoral_handoff', 'declined_contact', 'invalid_contact', 'closed_no_response', 'other_resolved']
        && note is string
        && note.size() <= 160;
    }
    function validFollowupCreate(orgId, followupId) {
      let careRequestId = request.resource.data.get('careRequestId', '');
      let personId = request.resource.data.get('personId', '');
      let carePath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/careRequests/$(careRequestId);
      let personPath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/people/$(personId);
      let careData = get(carePath).data;
      let personData = get(personPath).data;
      return request.resource.data.keys().hasOnly([
          'organizationId', 'congregationId', 'personId', 'careRequestId', 'kind',
          'status', 'ownerRef', 'dueAt', 'createdAt', 'createdBy',
          'completedAt', 'completedBy', 'outcomeCode', 'nextActionCode'
        ])
        && request.resource.data.get('organizationId', '') == orgId
        && followupId == 'first-contact-' + careRequestId
        && request.resource.data.get('kind', '') == 'first_contact'
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('ownerRef', '') == request.auth.uid
        && request.resource.data.get('createdAt', null) == request.time
        && request.resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.get('completedAt', null) == null
        && request.resource.data.get('completedBy', '') == ''
        && request.resource.data.get('outcomeCode', '') == ''
        && request.resource.data.get('nextActionCode', '') == ''
        && canManageCare(orgId)
        && careData.get('status', '') == 'open'
        && careData.get('careType', '') == 'first_contact'
        && careData.get('ownerRef', '') == request.auth.uid
        && careData.get('personId', '') == personId
        && careData.get('congregationId', '') == request.resource.data.get('congregationId', '')
        && request.resource.data.get('dueAt', null) == careData.get('dueAt', null)
        && personData.get('congregationId', '') == request.resource.data.get('congregationId', '')
        && personData.get('consent', false) == true
        && personData.get('phone', '') is string
        && personData.get('phone', '').size() > 0;
    }

    function validFollowupOutcomePair(outcomeCode, nextActionCode) {
      return
        (outcomeCode == 'responded' && nextActionCode == 'none')
        || (outcomeCode == 'prayer_requested' && nextActionCode == 'care_prayer')
        || (outcomeCode == 'group_interest' && nextActionCode == 'group_entry')
        || (outcomeCode == 'declined_contact' && nextActionCode == 'none')
        || (outcomeCode == 'invalid_contact' && nextActionCode == 'data_correction')
        || (outcomeCode == 'no_response' && nextActionCode == 'manual_review');
    }

    function validFollowupCareResolution(outcomeCode, resolutionCode) {
      return
        (outcomeCode in ['responded', 'prayer_requested', 'group_interest'] && resolutionCode == 'contact_completed')
        || (outcomeCode == 'declined_contact' && resolutionCode == 'declined_contact')
        || (outcomeCode == 'invalid_contact' && resolutionCode == 'invalid_contact')
        || (outcomeCode == 'no_response' && resolutionCode == 'closed_no_response');
    }

    function validFollowupComplete(orgId) {
      let careRequestId = resource.data.get('careRequestId', '');
      let carePath = /databases/$(database)/documents/organizations/$(orgId)/products/raiz_e_mesa/careRequests/$(careRequestId);
      let careData = getAfter(carePath).data;
      let outcomeCode = request.resource.data.get('outcomeCode', '');
      let nextActionCode = request.resource.data.get('nextActionCode', '');
      return resource.data.get('status', '') == 'pending'
        && resource.data.get('ownerRef', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'completedAt', 'completedBy', 'outcomeCode', 'nextActionCode'
        ])
        && request.resource.data.get('status', '') == 'completed'
        && request.resource.data.get('completedAt', null) == request.time
        && request.resource.data.get('completedBy', '') == request.auth.uid
        && validFollowupOutcomePair(outcomeCode, nextActionCode)
        && careData.get('status', '') == 'resolved'
        && careData.get('resolvedAt', null) == request.time
        && careData.get('resolvedBy', '') == request.auth.uid
        && validFollowupCareResolution(outcomeCode, careData.get('resolutionCode', ''));
    }

    function validImplementationKey(key) {
      return key is string
        && key.matches('^(prep[.][1-7]|week[.]1[.](practice|teach[.][1-4])|week[.]2[.](practice|teach[.][1-5])|week[.]3[.](practice|teach[.][1-4])|week[.]4[.](practice|teach[.][1-5])|week[.]5[.](practice|teach[.][1-5])|week[.]6[.](practice|teach[.][1-4])|week[.]7[.](practice|teach[.][1-5]))$');
    }
    function validImplementationCycleCreate(orgId) {
      return journeyTenantCreateFallback(orgId);
    }
    function journeyTenantCreateFallback(orgId) {
      return tenantCreate(orgId)
        && request.resource.data.get('congregationId', '') is string
        && request.resource.data.get('playbookId', '') == 'raiz_e_mesa_2026'
        && request.resource.data.get('status', '') == 'active'
        && request.resource.data.get('startedAt', null) == request.time
        && request.resource.data.get('createdAt', null) == request.time
        && request.resource.data.get('createdBy', '') == request.auth.uid;
    }
    function validGroupState() {
      let capacity = request.resource.data.get('capacity', 0);
      let participants = request.resource.data.get('participants', 0);
      return capacity is number
        && participants is number
        && capacity >= 1
        && capacity <= 100
        && participants >= 0
        && participants <= capacity;
    }
