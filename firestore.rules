      let previousStatus = resource.data.get('status', '');
      return request.resource.data.get('organizationId', '') == orgId
        && request.resource.data.get('organizationId', '') == resource.data.get('organizationId', '')
        && request.resource.data.get('congregationId', '') == resource.data.get('congregationId', '')
        && request.resource.data.get('groupId', '') == groupId
        && request.resource.data.get('personId', '') == resource.data.get('personId', '')
        && request.resource.data.get('personName', '') == resource.data.get('personName', '')
        && canManageGroupRoster(orgId, groupId)
        && (
          (
            previousStatus == 'active'
            && nextStatus == 'left'
            && request.resource.data.get('joinedAt', null) == resource.data.get('joinedAt', null)
            && request.resource.data.get('joinedBy', '') == resource.data.get('joinedBy', '')
            && request.resource.data.get('leftAt', null) == request.time
            && request.resource.data.get('leftBy', '') == request.auth.uid
          )
          ||
          (
            previousStatus == 'left'
            && nextStatus == 'active'
            && request.resource.data.get('joinedAt', null) == request.time
            && request.resource.data.get('joinedBy', '') == request.auth.uid
