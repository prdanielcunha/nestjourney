        ])
        && resource.data.get('organizationId', '') == orgId
        && request.resource.data.get('organizationId', '') == orgId
        && request.resource.data.get('organizationId', '') == resource.data.get('organizationId', '')
        && request.resource.data.get('congregationId', '') == resource.data.get('congregationId', '')
        && request.resource.data.get('groupId', '') == groupId
        && request.resource.data.get('personId', '') == personId
        && request.resource.data.get('personName', '') == resource.data.get('personName', '')
        && request.resource.data.get('requestedAt', null) == resource.data.get('requestedAt', null)
        && request.resource.data.get('requestedBy', '') == resource.data.get('requestedBy', '')
        && resource.data.get('status', '') == 'pending'
        && nextStatus in ['accepted', 'declined']
        && request.resource.data.get('resolvedAt', null) == request.time
        && request.resource.data.get('resolvedBy', '') == request.auth.uid
        && canManageGroupRoster(orgId, groupId)
