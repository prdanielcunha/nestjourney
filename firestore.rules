        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('requestedAt', null) == request.time
        && request.resource.data.get('requestedBy', '') == request.auth.uid
        && request.resource.data.get('resolvedAt', null) == null
        && request.resource.data.get('resolvedBy', '') == ''
        && canCreateGroupEntryRequest(orgId, groupId)
