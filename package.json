{
  "name": "nestjourney",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run --exclude firestore.rules.test.ts",
    "test:rules": "npx -y firebase-tools@14.25.1 emulators:exec --config firebase.emulator.json --only firestore --project nestjourney-rules-test \"vitest run firestore.rules.test.ts\"",
    "check": "npm run lint && npm test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
